vehicle_type = input("Enter vehicle type (2 wheeler/4 wheeler/heavy): ").strip().lower()
hours = int(input("Enter parking duration in hours: "))

if vehicle_type == "2 wheeler":
    rate = 20
elif vehicle_type == "4 wheeler":
    rate = 50
elif vehicle_type == "heavy":
    rate = 100
else:
    print("Invalid vehicle type")
    exit()

fee = rate * hours

print("Vehicle type:", vehicle_type)
print("Parking duration in hours:", hours)
print("Total parking fee Rs:", fee)
